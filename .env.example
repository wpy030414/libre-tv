# ===== 服务端口 =====
PORT=11408

# ===== 源站上游（hanime1）=====
# 可选：上游请求代理（大陆网络直连被 Cloudflare 拦截时填本机代理）
# HANIME1_PROXY=http://127.0.0.1:7897
# 可选：仅 DoH 解析走的代理（本地 DNS 被污染时用；站点访问仍直连）
# HANIME1_DNS_PROXY=http://127.0.0.1:7897
# 可选：钉死上游 IPv4，跳过 DoH（CDN 漂移时手动指定）
# HANIME1_RESOLVE=104.26.8.104
# 可选：Cloudflare clearance Cookie（浏览器通过人机验证后从 DevTools 复制）
# 注意：cf_clearance 绑定出口 IP 与浏览器指纹，过期后需重新获取
# HANIME1_COOKIE=cf_clearance=xxxx
# 可选：镜像/换域名时覆盖基址（默认 https://hanime1.me）
# HANIME1_BASE_URL=https://hanime1.me

# ===== 本地库 =====
# 可选：数据目录（默认仓库根 data/，含 library.db 与 media/）
# DATA_DIR=./data
